.git
.gitignore
node_modules
dist
coverage
.earwitness
.env
*.log
.DS_Store

# Working docs / review notes — not needed in the image.
.reviews
FIXES.md
REVIEW.md

# Docker files themselves
Dockerfile
docker-compose.yml
.dockerignore
DOCKER.md
