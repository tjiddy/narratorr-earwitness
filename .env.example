# Earwitness config. Copy to .env for native dev (the server loads it via process.loadEnvFile).
# All values are host-agnostic; inside docker-compose use service hostnames, not localhost.

# Server
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Run mode: auto-detects "narratorr" when NARRATORR_URL + NARRATORR_API_KEY are set, else "standalone".
# MODE=standalone

# Standalone: directories the folder-picker is allowed to browse/scan (comma-separated, absolute).
BROWSE_ROOTS=C:\Users\Todd\Audiobooks

# Extraction LLM (Ollama). In compose: http://ollama:11434
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# Transcription (Whisper HTTP service). In compose: http://whisper:8000
WHISPER_HOST=http://localhost:8000
# Backend adapter: whispercpp | openai-compat | transformersjs (dev/CPU fallback)
WHISPER_BACKEND=openai-compat
WHISPER_MODEL=large-v3-turbo

# Intro extraction window
INTRO_SECONDS=60
INTRO_OFFSET_SECONDS=0

# Concurrency (kept low — STT/LLM are heavy and a single GPU serializes)
MAX_CONCURRENT_BOOKS=2
MAX_CONCURRENT_TRANSCRIBES=1

# Paths
CACHE_DIR=./.earwitness/cache
REPORTS_DIR=./.earwitness/reports
# FFMPEG_PATH=

# Narratorr integration (leave unset for standalone mode)
# NARRATORR_URL=http://localhost:8080
# NARRATORR_API_KEY=
