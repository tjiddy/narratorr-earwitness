# Earwitness config. Copy to .env for native dev (the server loads it via process.loadEnvFile).
# All values are host-agnostic; inside docker-compose use service hostnames, not localhost.

# Server
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
# Log level (pino): fatal|error|warn|info|debug|trace|silent. Default info — the
# attribution chain (transcript size, raw extraction, evidence nulling, final
# detection) is logged at info; debug also dumps full transcripts + evidence spans.
# LOG_LEVEL=info

# Network exposure. BIND_HOST defaults to 0.0.0.0 (Docker/LAN).
# BIND_HOST=0.0.0.0
#
# API key: earwitness OWNS its key — it generates + persists one on first boot and
# prints it once in the logs. /api/* requires it from the network as
# `Authorization: Bearer <key>` OR `X-Api-Key: <key>` (narratorr sends the latter);
# loopback (local UI / curl) is trusted without it. The key persists next to the
# cache dir (./.earwitness/api-key in dev, /data/api-key in compose). To bring your
# own, write that file — do NOT set it via env. Override only the LOCATION:
# EARWITNESS_API_KEY_FILE=./.earwitness/api-key

# Run mode is DERIVED, not set directly: it reports "narratorr" when NARRATORR_URL +
# NARRATORR_API_KEY are both set, else "standalone". It's surfaced in /api/config and
# /api/v1/health for display only — there is no MODE env var.

# Standalone: directories the folder-picker is allowed to browse/scan (comma-separated, absolute).
BROWSE_ROOTS=C:\Users\Todd\Audiobooks

# Extraction LLM (Ollama). In compose: http://ollama:11434
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# Transcription (Whisper HTTP service). In compose: http://whisper:8000
WHISPER_HOST=http://localhost:8000
# Backend adapter: whispercpp | openai-compat | transformersjs (dev/CPU fallback)
WHISPER_BACKEND=openai-compat
WHISPER_MODEL=large-v3-turbo

# Intro extraction window
INTRO_SECONDS=60
INTRO_OFFSET_SECONDS=0
# Tail sampling: when the head window has no complete attribution, also transcribe the
# last INTRO_SECONDS of the file (Audible & co. put the credit at the END). Default on;
# only the books the head can't resolve pay for a second transcription. false to disable.
# TAIL_SAMPLING=true

# Debug attribution console (POST /api/debug/attribution + a "Debug" tab in the UI).
# OFF by default. When on it returns FULL transcripts + internals to any API-key holder
# and lets you A/B Whisper models in-process (which evicts the live model). Turn it on to
# diagnose a miss, OFF when done. Needs the API key from a non-loopback browser.
# EARWITNESS_DEBUG_ATTRIBUTION=true

# Concurrency (kept low — STT/LLM are heavy and a single GPU serializes)
MAX_CONCURRENT_BOOKS=2
MAX_CONCURRENT_TRANSCRIBES=1
# Process-wide cap on active+queued scans; excess POST /api/scans → 503.
MAX_ACTIVE_SCANS=4

# Per-call timeouts (ms; 0 disables) so a hung service can't wedge a worker forever.
TRANSCRIBE_TIMEOUT_MS=300000
EXTRACT_TIMEOUT_MS=120000

# Paths (resolved against the repo root, not the launch cwd)
CACHE_DIR=./.earwitness/cache
REPORTS_DIR=./.earwitness/reports
# FFMPEG_PATH=

# Narratorr integration. The live integration is INBOUND — narratorr calls
# POST /api/v1/attribution (see EARWITNESS_LIBRARY_ROOT below). These two vars only set
# the reported run mode (above) to "narratorr"; leave unset for "standalone".
# NARRATORR_URL=http://localhost:8080
# NARRATORR_API_KEY=

# Shared library mount root that POST /api/v1/attribution resolves narratorr's
# library-relative paths against (with a containment guard). Point it at the same
# library narratorr references. Default: /audiobooks.
# EARWITNESS_LIBRARY_ROOT=/audiobooks
